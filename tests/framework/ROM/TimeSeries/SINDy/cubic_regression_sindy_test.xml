<?xml version="1.0" ?>
<Simulation verbosity="silent">

  <RunInfo>
    <WorkingDir>SINDyCubicReg</WorkingDir>
    <Sequence>firstMRun,trainRom,sampleRom,plot</Sequence>
    <batchSize>1</batchSize>
  </RunInfo>

  <Steps>
    <MultiRun name="firstMRun" pauseAtEnd="True">
      <Input class="DataObjects" type="PointSet">inputPlaceHolder</Input>
      <Model class="Models" type="ExternalModel">cubic_poly</Model>
      <Sampler class="Samplers" type="MonteCarlo">mcSampler</Sampler>
      <Output class="DataObjects" type="PointSet">outMC</Output>
      <Output class="OutStreams" type="Print">outMC</Output>
    </MultiRun>
    <RomTrainer name="trainRom">
      <Input class="DataObjects" type="PointSet">outMC</Input>
      <Output class="Models" type="ROM">myROM</Output>
    </RomTrainer>
    <MultiRun name="sampleRom">
      <Input class="DataObjects" type="PointSet">testingSet</Input>
      <Model class="Models" type="ROM">myROM</Model>
      <Sampler class="Samplers" type="MonteCarlo">testSetMCSampler</Sampler>
      <Output class="DataObjects" type="PointSet">testRomOut</Output>
      <Output class="OutStreams" type="Print">testRomIDWOut</Output>
    </MultiRun>
    <IOStep name="plot">
      <Input class="DataObjects" type="PointSet">outMC</Input>
      <Input class="DataObjects" type="PointSet">testRomOut</Input>
      <Output class="OutStreams" type="Plot">plotMC</Output>
    </IOStep>
  </Steps>

  <Models>
    <ExternalModel ModuleToLoad="cube_model" name="cubic_poly" subType="">
      <variables>x,y</variables>
    </ExternalModel>
    <ROM name="myROM" subType="SINDy">
      <Features>x</Features>
      <Target>y</Target>
      <degree>3</degree>
    </ROM>
  </Models>

  <Samplers>
    <MonteCarlo name="mcSampler">
      <samplerInit>
        <limit>30</limit>
        <initialSeed>42</initialSeed>
      </samplerInit>
      <variable name="x">
        <distribution>uni</distribution>
      </variable>
    </MonteCarlo>
    <MonteCarlo name="testSetMCSampler">
      <samplerInit>
        <limit>50</limit>
        <initialSeed>0</initialSeed>
      </samplerInit>
      <variable name="x">
        <distribution>uni</distribution>
      </variable>
    </MonteCarlo>
  </Samplers>

  <Distributions>
    <Uniform name="uni">
      <lowerBound>-2</lowerBound>
      <upperBound>2</upperBound>
    </Uniform>
  </Distributions>

  <DataObjects>
    <PointSet name="inputPlaceHolder">
      <Input>x</Input>
    </PointSet>
    <PointSet name="outMC">
      <Input>x</Input>
      <Output>y</Output>
    </PointSet>
    <PointSet name="testRomOut">
      <Input>x</Input>
      <Output>y</Output>
    </PointSet>
    <PointSet name="testingSet">
      <Input>x</Input>
      <Output>OutputPlaceHolder</Output>
    </PointSet>
  </DataObjects>

  <OutStreams>
    <Print name="outMC">
      <type>csv</type>
      <source>outMC</source>
    </Print>
    <Print name="testRomIDWOut">
      <type>csv</type>
      <source>testRomOut</source>
    </Print>
    <Plot name="plotMC">
      <plotSettings>
        <plot>
          <type>scatter</type>
          <x>outMC|Input|x</x>
          <y>outMC|Output|y</y>
          <c>red</c>
          <marker>o</marker>
          <kwargs>
            <label>ground truth</label>
          </kwargs>
        </plot>
        <plot>
          <type>scatter</type>
          <x>testRomOut|Input|x</x>
          <y>testRomOut|Output|y</y>
          <c>blue</c>
          <marker>*</marker>
          <kwargs>
            <label>SINDy ROM</label>
          </kwargs>
        </plot>
        <xlabel>x</xlabel>
        <ylabel>y</ylabel>
        <legend>
          <ncol>2</ncol>
        </legend>
      </plotSettings>
      <actions>
        <how>png</how>
      </actions>
    </Plot>
  </OutStreams>

</Simulation>
